# Optional environment overrides. Most installations should use config.json instead.
# One or more absolute media folders, separated by : on macOS/Linux.
MEDIA_DIRS=/Users/you/Movies

# The HTTP port. The app listens on all interfaces so it is reachable through Tailscale.
PORT=8787

# Optional: rescan interval in milliseconds.
SCAN_INTERVAL_MS=30000

# Optional size cutoff for grouping short features and bonus content under Extras.
EXTRA_THRESHOLD_MB=800

# Optional custom media player. If omitted, macOS uses `open` and Linux uses `xdg-open`.
# PLAYER_COMMAND=/Applications/VLC.app/Contents/MacOS/VLC
# PLAYER_ARGS_JSON=["--fullscreen","{file}"]
